# Application
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=lms
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Users / JIT provisioning
USERS_ID_MAX_LENGTH=36
USERS_USERNAME_MAX_LENGTH=255
USERS_EMAIL_MAX_LENGTH=255
USERS_FIRST_NAME_MAX_LENGTH=255
USERS_LAST_NAME_MAX_LENGTH=255
USERS_ACTION_NAME_MAX_LENGTH=255
USERS_ACTIVITY_WORKER_NAME=user-activity-worker

# Keycloak Configuration
KEYCLOAK_BASE_URL=https://sso.skill-wanderer.com/
KEYCLOAK_REALM=skill-wanderer
KEYCLOAK_ISSUER_URL=https://sso.skill-wanderer.com/realms/skill-wanderer
KEYCLOAK_JWKS_URI=https://sso.skill-wanderer.com/realms/skill-wanderer/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=lms-backend

# Submission Settings
SUBMISSIONS_MAX_CONTENT_LENGTH=10000
SUBMISSIONS_MAX_FILE_SIZE_MB=10
SUBMISSIONS_MAX_FILES=10
SUBMISSIONS_ALLOWED_MIME_TYPES=application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg
SUBMISSIONS_ANTI_SPAM_WINDOW_SECONDS=30
SUBMISSIONS_FILE_NAME_MAX_LENGTH=500
SUBMISSIONS_FILE_MIMETYPE_MAX_LENGTH=255
SUBMISSIONS_DRIVE_FILE_ID_MAX_LENGTH=255

# Google Drive Upload
DRIVE_UPLOAD_ENABLED=false
# DRIVE_FOLDER_ID=your-drive-folder-id
# DRIVE_OAUTH_CLIENT_ID=your-oauth-client-id
# DRIVE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# DRIVE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token

# Docker Compose helpers
DOCKER_POSTGRES_CONTAINER_NAME=lms_postgres
DOCKER_POSTGRES_HOST_PORT=5433
DOCKER_PGADMIN_CONTAINER_NAME=lms-be-pgadmin
DOCKER_PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Optional API container settings
DOCKER_API_CONTAINER_NAME=lms-be-api
DOCKER_API_HOST_PORT=4001
