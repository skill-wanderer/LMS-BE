# Application
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=lms

# Keycloak Configuration
KEYCLOAK_BASE_URL=https://sso.skill-wanderer.com/
KEYCLOAK_REALM=skill-wanderer
KEYCLOAK_ISSUER_URL=https://sso.skill-wanderer.com/realms/skill-wanderer
KEYCLOAK_JWKS_URI=https://sso.skill-wanderer.com/realms/skill-wanderer/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=lms-backend

# Submission Settings
SUBMISSIONS_MAX_FILE_SIZE_MB=10
SUBMISSIONS_MAX_FILES=10
SUBMISSIONS_ALLOWED_MIME_TYPES=application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg
SUBMISSIONS_ANTI_SPAM_WINDOW_SECONDS=30
SUBMISSIONS_RETENTION_DAYS=30
SUBMISSIONS_ARCHIVED_PURGE_DAYS=0
SUBMISSIONS_CLEANUP_BATCH_SIZE=100
SUBMISSIONS_ORPHAN_SCAN_BATCH_SIZE=100

# Dynamic maintenance schedules (cron)
SUBMISSIONS_CLEANUP_SCHEDULE=*/5 * * * *
SUBMISSIONS_ORPHAN_SCAN_SCHEDULE=*/10 * * * *
SUBMISSIONS_SERVER_TIMEZONE=Asia/Ho_Chi_Minh

# Optional fallback timezone key (legacy)
SERVER_TIMEZONE=Asia/Ho_Chi_Minh

SUBMISSIONS_SYSTEM_ACTOR_ID=00000000-0000-0000-0000-000000000000

# Google Drive Upload
DRIVE_UPLOAD_ENABLED=false
# DRIVE_FOLDER_ID=your-drive-folder-id
# DRIVE_OAUTH_CLIENT_ID=your-oauth-client-id
# DRIVE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# DRIVE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token
